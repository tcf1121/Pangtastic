  m_SharedData: {fileID: 11400000, guid: af82b962d0cea7e498ef6bb0610d3c6c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1342907326464
    m_Localized: "\uC790, \uC774\uC81C \uB108\uAC00 \uC5BC\uB9C8\uB098 \uC131\uC7A5\uD588\uB294\uC9C0
      \uBCF4\uACE0 \uC2F6\uAD6C\uB098. \uB0B4\uAC8C \uD325\uBE75 1\uAC1C\uB97C \uB9CC\uB4E4\uC5B4\uC8FC\uB834."
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326465
    m_Localized: "\"\uC74C, \uC544\uC8FC \uB9DB\uC788\uAD6C\uB098! \uC774 \uC815\uB3C4\uBA74
      \uBE75 \uB9CC\uB4DC\uB294 \uAC83\uC5D0 \uB300\uD574\uC11C\uB294 \uB354 \uC774\uC0C1
      \uB0B4 \uB3C4\uC6C0\uC774 \uD544\uC694\uAC00 \uC5C6\uACA0\uAD6C\uB098.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326466
    m_Localized: "\"\uB0B4\uAC8C \uC0B0 \uBC00\uAC00\uB8E8\uB294 \uC798 \uC4F0\uACE0
      \uC788\uC9C0? \uADF8\uB7F0\uB370 \uB9C9\uC0C1 \uB0B4 \uBC00\uAC00\uB8E8\uB85C
      \uB9CC\uB4E0 \uBE75\uC744 \uB098\uB294 \uBA39\uC5B4\uBCF8 \uC801\uC774 \uC5C6\uB2E8
      \uB9D0\uC774\uC9C0...\uADF8\uB798\uC11C \uADF8\uB7F0\uB370 \uD638\uBC00\uBE75
      \uD558\uB098\uB9CC \uB9CC\uB4E4\uC5B4\uC918!\""
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326467
    m_Localized: "\"\uC5ED\uC2DC \uB0B4 \uBC00\uC774\uC57C...\uC815\uB9D0 \uB9DB\uC788\uC5B4!
      \uACE0\uB9C8\uC6CC \uC798 \uBA39\uC5C8\uC5B4! \uC55E\uC73C\uB85C\uB3C4 \uC885\uC885
      \uBD80\uD0C1\uD560\uAC8C!\""
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326468
    m_Localized: "\"\uC790\uB124 \uC694\uC998\uC5D0\uB294 \uAE30\uACC4\uC5D0 \uBB38\uC81C
      \uC5C6\uB294\uAC00? \uC628 \uAE40\uC5D0 \uB098\uB3C4 \uBE75 \uD558\uB098\uB9CC
      \uBD80\uD0C1\uD558\uC9C0. \uCE58\uC988\uBE75\uC73C\uB85C \uD558\uB098 \uB9CC\uB4E4\uC5B4\uC8FC\uC2DC\uAC8C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326469
    m_Localized: "\"\uC74C....\uC544\uC8FC \uCAC0\uB4DD\uCAC0\uB4DD\uD558\uAD6C\uB9CC...\uB9DB\uC774
      \uC544\uC8FC \uC798 \uB290\uAEF4\uC838....3000\uAC1C\uB3C4 \uBA39\uC744 \uC218
      \uC788\uC744 \uAC83 \uAC19\uAD6C\uB9CC. \uB9CC\uB4E4\uC5B4\uC918\uC11C \uACE0\uB9D9\uB124.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326470
    m_Localized: "\"\uC5EC\uAE30\uAC00 \uADF8\uB807\uAC8C \uBE75\uC744 \uC798 \uB9CC\uB4E0\uB2E4\uB294
      \uC18C\uC2DD\uC744 \uB4E3\uACE0 \uC654\uC2B5\uB2C8\uB2E4. \uC8FC\uC778\uC7A5\uC758
      \uD0DC\uB3C4, \uC637\uCC28\uB9BC, \uC190\uB180\uB9BC\uC744 \uBCF4\uB2C8 \uADF8
      \uC18C\uC2DD\uC774 \uC0AC\uC2E4\uC778 \uAC83 \uAC19\uAD70\uC694. \uBC14\uAC8C\uD2B8
      \uBE75 \uD558\uB098 \uB9CC\uB4E4\uC5B4 \uC8FC\uC138\uC694.\"\n(\uD50C\uB808\uC774\uC5B4\uC758
      \uB300\uB2F5) \"\uB124...? \uBC14\uAC8C\uD2B8\uBE75\uC744 \uBAA8\uB978\uB2E4\uAD6C\uC694...?
      \uB9D9\uC18C\uC0AC, \uBE75 \uC911\uC5D0\uC11C \uAC00\uC7A5 \uADFC\uBCF8 \uC788\uB294
      \uBE75\uC744 \uBAA8\uB978\uB2E4\uAD6C\uC694? \uB808\uC2DC\uD53C\uB97C \uC801\uC5B4\uB4DC\uB9B4\uD14C\uB2C8
      \uC774\uB300\uB85C \uB9CC\uB4E4\uC5B4\uC8FC\uC2ED\uC2DC\uC624.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326471
    m_Localized: "\"\uC74C...\uBCF8\uB798\uC5D0 \uB9DB\uC5D0 \uBE44\uD558\uBA74 \uC544\uC9C1
      \uD55C\uCC38 \uBAA8\uC790\uB77C\uC9C0\uB9CC \uC624\uB298\uC740 \uC774\uC815\uB3C4\uB85C
      \uB9CC\uC871\uD558\uACA0\uC2B5\uB2C8\uB2E4. \uB2E4\uC74C\uBC88\uC5D0 \uB2E4\uC2DC
      \uC654\uC744 \uB54C\uB294 \uB354 \uC798 \uB9CC\uB4E4 \uAC83\uC774\uB77C \uBBFF\uACA0\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326472
    m_Localized: "\"\uC15C\uB85D \uC800 \uB0E5\uBC18\uC774 \uC6D0\uB798 \uC7AC\uC218\uAC00
      \uC880 \uC5C6\uC2B5\uB2C8\uB2E4. \uC0AC\uC7A5\uB2D8\uC774 \uC774\uD574\uD574\uC8FC\uC2ED\uC1FC.
      \uC624\uB298 \uC800 \uB0E5\uBC18 \uB54C\uBB38\uC5D0 \uC2A4\uD2B8\uB808\uC2A4
      \uBC1B\uC544\uC11C \uADF8\uB7F0\uAC00 \uB2E8 \uAC83\uC774 \uB561\uAE30\uB124\uC694.
      \uD639\uC2DC \uCD08\uCF54\uBE75 \uD558\uB098 \uB9CC\uB4E4\uC5B4 \uC8FC\uC2E4
      \uC218 \uC788\uACA0\uC2B5\uB2C8\uAE4C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326473
    m_Localized: "\"\uC544! \uB2E8 \uAC83\uC744 \uBA39\uC73C\uB2C8 \uADF8\uB798\uB3C4
      \uC2A4\uD2B8\uB808\uC2A4\uAC00 \uC880 \uD480\uB9AC\uACE0 \uAE30\uBD84\uC774
      \uC88B\uC544\uC9C0\uB124\uC694. \uC815\uB9D0 \uAC10\uC0AC\uD569\uB2C8\uB2E4!
      \uB2E4\uC74C \uBC88\uC5D0 \uB610 \uC624\uACA0\uC2B5\uB2C8\uB2E4!\""
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326474
    m_Localized: "(\uC624\uB298\uC740 \uD06C\uB77C\uD2B8\uC758 \uC0DD\uC77C\uC774\uB2E4.
      \uADF8\uB798\uB3C4 \uB9C8\uC744 \uCE5C\uAD6C\uC778\uB370 \uBB50\uB77C\uB3C4
      \uC120\uBB3C\uD574\uC918\uC57C\uC9C0. \uB0B4\uAC00 \uC904 \uC218 \uC788\uB294
      \uC120\uBB3C\uC740....\uADF8\uB798! \uB538\uAE30 \uCF00\uC774\uD06C\uB97C \uB9CC\uB4E4\uC5B4\uC11C
      \uBCF4\uB0B4\uC8FC\uC790!)"
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326475
    m_Localized: "(\uD06C\uB77C\uD2B8\uC5D0\uAC8C \uD3B8\uC9C0\uAC00 \uC654\uB2E4.
      \uCF00\uC774\uD06C \uC798 \uBC1B\uC558\uACE0 \uC815\uB9D0 \uACE0\uB9D9\uB2E4\uB294
      \uD3B8\uC9C0\uC600\uB2E4. \uB367\uBD99\uC5EC\uC11C \uB2E4\uC74C\uBC88\uC5D0
      \uAC00\uAC8C\uB97C \uD55C\uBC88 \uC624\uACA0\uB2E4\uB294 \uB0B4\uC6A9\uB3C4
      \uC788\uC5C8\uB2E4. \uC798 \uBC1B\uC558\uB2E4\uB2C8 \uB2E4\uD589\uC774\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326476
    m_Localized: "\"\uD615/\uB204\uB098! \uC5C4\uB9C8 \uC548\uC654\uC8E0?  \uB2E4\uD589\uC774\uB2E4
      \uD788\uD79B. \uB098 \uD615/\uB204\uB098(\uC774)\uAC00 \uB9CC\uB4E0 \uC0AC\uACFC\uBE75
      \uBA39\uACE0 \uC2F6\uC5B4\uC694 \uC0AC\uACFC\uBE75! \uC5C4\uB9C8 \uC624\uAE30
      \uC804\uC5D0 \uBE68\uB9AC\uC694!\""
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326477
    m_Localized: "\"\uC5ED\uC2DC \uD615/\uB204\uB098(\uC774)\uAC00 \uB9CC\uB4E0 \uC0AC\uACFC\uBE75\uC774
      \uCD5C\uACE0\uC5D0\uC694! \uACE0\uB9D9\uC2B5\uB2C8\uB2E4! \uB2E4\uC74C\uC5D0
      \uB610 \uC62C\uAC8C\uC694! \uC544, \uC5C4\uB9C8\uD55C\uD14C \uC624\uB298 \uC800
      \uC654\uB2E4\uB294 \uAC74 \uBE44\uBC00\uC774\uC5D0\uC694!\""
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326478
    m_Localized: "\"\uD615/\uB204\uB098...\uC548\uB155\uD558\uC138\uC694....\uC544....\uC800
      \uBA54\uB860\uBE75\uC774 \uBA39\uACE0\uC2F6\uC5B4\uC11C....\uD558\uB098 \uBD80\uD0C1\uB4DC\uB824\uB3C4
      \uB420\uAE4C\uC694....?\""
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326479
    m_Localized: "\"\uAC10\uC0AC\uD569\uB2C8\uB2E4...! \uC815\uB9D0 \uB9DB\uC788\uC5C8\uC5B4\uC694...!
      \uB2E4\uC74C \uBC88\uC5D0 \uB610 \uC624\uACA0\uC2B5\uB2C8\uB2E4...!\""
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326480
    m_Localized: "\"\uC5B4\uD734...\uB0B4\uAC00 \uCF54\uCF54 \uB54C\uBB38\uC5D0 \uC9C4\uC9DC
      \uBABB\uC0B4\uC544 \uC9C4\uC9DC. \uB9E4\uC77C \uB9E4\uC77C \uC0AC\uACE0\uB97C
      \uCE58\uACE0 \uB2E4\uB2C8\uB294\uB370 \uBBF8\uCE58\uACA0\uB124\uC694 \uC815\uB9D0.
      \uC544, \uC0AC\uC7A5\uB2D8 \uBE14\uB8E8\uBCA0\uB9AC\uBE75 \uD558\uB098 \uB9CC\uB4E4\uC5B4\uC8FC\uC138\uC694.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326481
    m_Localized: "\"\uB9E4\uBC88 \uAC10\uC0AC\uD574\uC694. \uC0AC\uC7A5\uB2D8 \uBE75\uC774
      \uC815\uB9D0 \uB9DB\uC788\uAC70\uB4E0\uC694. \uB2E4\uC74C\uC5D0 \uB610 \uC62C\uAC8C\uC694!\""
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
