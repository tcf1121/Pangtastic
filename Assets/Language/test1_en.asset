  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: test1_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: af82b962d0cea7e498ef6bb0610d3c6c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1342907326481
    m_Localized: '"Thank you every time. Your bread is really delicious. I''ll come
      again next time!"'
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326480
    m_Localized: '"Oh my... I can''t live because of Coco. She keeps causing trouble
      every single day, it''s driving me crazy. Oh, boss, please make me a blueberry
      bun."'
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326479
    m_Localized: '"Thank you...! It was really delicious...! I''ll come again next
      time...!"'
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326478
    m_Localized: '"Brother/sister...hello...ah...I want to eat melon bread...can
      I ask for one...?"'
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326477
    m_Localized: '"As expected, the apple bread made by my brother/sister is the
      best! Thank you! I''ll come again next time! Oh, and keep it a secret from
      Mom that I came today!"'
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326476
    m_Localized: '"Brother/Sister! Mom isn''t here, is she? That''s a relief hehe.
      I want to eat the apple bread that my brother/sister made! Apple bread! Hurry
      up before Mom gets here!"'
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326475
    m_Localized: (I got a letter from Kratt. It was a letter saying that he had received
      the cake and was truly grateful. It also said that he would come to the store
      next time. I'm glad he received it.)
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326474
    m_Localized: (Today is Krat's birthday. But he's a friend from the village, so
      I should give him something. The gift I can give him is... Yes! Let's make
      a strawberry cake and send it to him!)
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326473
    m_Localized: '"Ah! Eating something sweet relieves some stress and makes me feel
      better. Thank you so much! I''ll come again next time!"'
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326472
    m_Localized: '"Sherlock, that guy''s not exactly lucky. I hope you understand.
      I''m stressed out because of that guy today, so I''m craving something sweet.
      Could you make me a chocolate bun?"'
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326471
    m_Localized: '"Well... it''s still a bit lacking compared to the original taste,
      but I''ll be satisfied with this for today. I''m sure you''ll make it even
      better next time you come."'
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326470
    m_Localized: '"I came here because I heard this place makes such good bread.
      Judging by the owner''s attitude, attire, and hand movements, I think the rumor
      is true. Please make me a baguette."

      (Player''s response) "Huh...? You
      don''t know what a baguette is...? Oh my, you don''t know this most fundamental
      of breads? I''ll write down the recipe, so just make it."'
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326469
    m_Localized: '"Hmm... They''re really chewy... The flavor is really good... I
      think I could eat 3000 of them. Thank you for making them."'
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326468
    m_Localized: '"Are you having any problems with the machine these days? While
      you''re here, I''d like to ask for some bread too. Could you make me a cheese
      bread?"'
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326467
    m_Localized: '"As expected, it''s my wheat... It''s really delicious! Thank you,
      I enjoyed it! I''ll be ordering it often in the future!"'
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326466
    m_Localized: '"Are you using the flour you bought for me well? But I''ve never
      eaten bread made with my own flour... So, please make me just one rye bread!"'
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326465
    m_Localized: '"Mmm, this is really delicious! I guess you won''t need my help
      with baking anymore."'
    m_Metadata:
      m_Items: []
  - m_Id: 1342907326464
    m_Localized: Now, I want to see how much you've grown. Make me a red bean bun.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
