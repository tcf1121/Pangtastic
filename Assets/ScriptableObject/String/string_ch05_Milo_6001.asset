  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_ch05_Milo_6001
  m_EditorClassIdentifier: 
  ID: string_ch05_Milo_6001
  value:
  - "\u201CHmm\u2026 Freshly baked bread is better than I thought. I could eat it
    every day without getting tired of it.\u201D"
  - 
  - "Hmm... frisch gebckenen Brot ist besser, als ich dachte. Ich k\xF6nnte es jeden
    Tag essen, ohne es satt zu haben."
  - "\u55EF\u2026\u521A\u51FA\u7089\u7684\u5410\u53F8\uFF0C\u6BD4\u60F3\u8C61\u4E2D\u66F4\u7F8E\u5473\u3002\u6BCF\u5929\u5403\u4E5F\u4E0D\u4F1A\u817B\u5427\u3002"
  - "\u55EF\u2026\u525B\u51FA\u7210\u7684\u5410\u53F8\u610F\u5916\u5730\u7F8E\u5473\u3002\u6BCF\u5929\u5403\u90FD\u4E0D\u6703\u81A9\u5427\u3002"
  - "\u3075\u3080\u2026\u713C\u304D\u305F\u3066\u306E\u98DF\u30D1\u30F3\u3001\u601D\u3063\u305F\u3088\u308A\u60AA\u304F\u306A\u3044\u306D\u3002\u6BCE\u65E5\u98DF\u3079\u3066\u3082\u98FD\u304D\u306A\u3044\u3060\u308D\u3046\u3002"
  - "\uD750\uC74C\u2026 \uB9C9 \uB098\uC628 \uC2DD\uBE75, \uC0DD\uAC01\uBCF4\uB2E4
    \uAD1C\uCC2E\uB124. \uB9E4\uC77C \uBA39\uC5B4\uB3C4 \uC9C8\uB9AC\uC9C0 \uC54A\uACA0\uB2E4."
  - "Hmm... frisch gebckenen Brot ist besser, als ich dachte. Ich k\xF6nnte es jeden
    Tag essen, ohne es satt zu haben."
  - 
  - 
