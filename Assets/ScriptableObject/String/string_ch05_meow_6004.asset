  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_ch05_meow_6004
  m_EditorClassIdentifier: 
  ID: string_ch05_meow_6004
  value:
  - "\u201C\u2026Yes. This scenery is familiar. Even when I was little\u2026 my day
    would start like this with the smell of bread from my grandfather\u2019s shop.\u201D"
  - 
  - "...Ja. Dieses Bild kommt mir bekannt vor. Auch als ich klein war, hat mein Tag
    so begonnen, mit dem Duft von Brot aus dem Laden meines Gro\xDFvaters."
  - "\u2026\u2026\u662F\u554A\u3002\u8FD9\u666F\u8C61\u5E76\u4E0D\u964C\u751F\u3002\u5C0F\u65F6\u5019\u2026\u2026\u7237\u7237\u7684\u5E97\u91CC\u4E5F\u5E38\u8FD9\u6837\uFF0C\u7528\u9762\u5305\u9999\u6C14\u5F00\u542F\u4E00\u5929\u3002"
  - "\u2026\u662F\u554A\u3002\u9019\u5E45\u5149\u666F\u4E26\u4E0D\u964C\u751F\u3002\u5C0F\u6642\u5019\u2026\u5728\u723A\u723A\u7684\u5E97\u88E1\uFF0C\u4E5F\u662F\u9019\u6A23\u7528\u9EB5\u5305\u9999\u6C23\u958B\u555F\u6BCF\u4E00\u5929\u7684\u3002"
  - "\u2026\u305D\u3046\u3060\u306A\u3002\u3053\u306E\u5149\u666F\u3001\u898B\u899A\u3048\u304C\u3042\u308B\u3002\u5B50\u4F9B\u306E\u9803\u3082\u2026\u304A\u3058\u3044\u3061\u3083\u3093\u306E\u5E97\u3067\u3001\u3053\u3093\u306A\u98A8\u306B\u30D1\u30F3\u306E\u9999\u308A\u3067\u4E00\u65E5\u304C\u59CB\u307E\u3063\u305F\u3082\u306E\u3060\u3002"
  - "\u2026\uADF8\uB798. \uC774 \uD48D\uACBD, \uB0AF\uC124\uC9C0 \uC54A\uC544. \uC5B4\uB9B4
    \uC801\uC5D0\uB3C4\u2026 \uD560\uC544\uBC84\uC9C0 \uAC00\uAC8C\uC5D0\uC11C \uC774\uB807\uAC8C
    \uBE75 \uB0C4\uC0C8\uB85C \uD558\uB8E8\uAC00 \uC2DC\uC791\uB418\uACE4 \uD588\uC5B4."
  - "...Ja. Dieses Bild kommt mir bekannt vor. Auch als ich klein war, hat mein Tag
    so begonnen, mit dem Duft von Brot aus dem Laden meines Gro\xDFvaters."
  - 
  - 
  - 
  - 
  - 
