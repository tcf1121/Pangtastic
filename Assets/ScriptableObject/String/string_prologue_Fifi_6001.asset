  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_prologue_Fifi_6001
  m_EditorClassIdentifier: 
  ID: string_prologue_Fifi_6001
  value:
  - "\u201COh, you\u2019re finally here! I was waiting for you since I heard you
    were going to revive this shop.\u201D"
  - 
  - 
  - "\u54A6\uFF0C\u4F60\u7EC8\u4E8E\u6765\u4E86\uFF01\u542C\u8BF4\u4F60\u8981\u91CD\u632F\u8FD9\u5BB6\u5E97\uFF0C\u6211\u4E00\u76F4\u5728\u7B49\u5462\u3002"
  - "\u54A6\uFF0C\u4F60\u7D42\u65BC\u4F86\u4E86\uFF01\u807D\u8AAA\u4F60\u8981\u91CD\u632F\u9019\u9593\u5E97\u92EA\uFF0C\u6211\u4E00\u76F4\u5728\u7B49\u8457\u5462\u3002"
  - "\u304A\u3063\u3001\u3084\u3063\u3068\u6765\u305F\u306D\uFF01\u541B\u304C\u3053\u306E\u5E97\u3092\u5FA9\u6D3B\u3055\u305B\u308B\u3063\u3066\u805E\u3044\u3066\u5F85\u3063\u3066\u305F\u3093\u3060\u3002"
  - " \u201C\uC5B4, \uB4DC\uB514\uC5B4 \uC654\uB124! \uB124\uAC00 \uC774 \uAC00\uAC8C\uB97C
    \uB2E4\uC2DC \uC0B4\uB9B0\uB2E4\uACE0 \uD574\uC11C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC5B4.\u201D "
