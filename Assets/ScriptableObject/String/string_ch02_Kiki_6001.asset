  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_ch02_Kiki_6001
  m_EditorClassIdentifier: 
  ID: string_ch02_Kiki_6001
  value:
  - Hello! I heard about this place too. Donuts and warm coffee... I'm really looking
    forward to it!
  - 
  - "Hallo! Ich habe auch von diesem Ort geh\xF6rt. Donuts und warmer Kaffee\u2026
    ich freue mich wirklich darauf!"
  - "\u60A8\u597D\uFF01\u6211\u4E5F\u542C\u95FB\u76DB\u540D\u4E13\u7A0B\u800C\u6765\u3002\u751C\u751C\u5708\u914D\u70ED\u5496\u5561\u2026\u2026\u73B0\u5728\u5C31\u671F\u5F85\u4E0D\u5DF2\u5462\uFF01"
  - "\u60A8\u597D\uFF01\u6211\u4E5F\u807D\u805E\u76DB\u540D\u7279\u5730\u524D\u4F86\u3002\u751C\u751C\u5708\u914D\u71B1\u5496\u5561\u2026\u2026\u5149\u60F3\u50CF\u5C31\u4EE4\u4EBA\u671F\u5F85\uFF01"
  - "\u3053\u3093\u306B\u3061\u306F\uFF01\u79C1\u3082\u5642\u3092\u805E\u3044\u3066\u6765\u307E\u3057\u305F\u3002\u30C9\u30FC\u30CA\u30C4\u306B\u6E29\u304B\u3044\u30B3\u30FC\u30D2\u30FC\u306A\u3093\u3066\u2026\u3082\u3046\u697D\u3057\u307F\u3067\u3059\uFF01"
  - "\uC548\uB155\uD558\uC138\uC694! \uC800\uB3C4 \uC18C\uBB38\uC744 \uB4E3\uACE0
    \uCC3E\uC544\uC654\uC5B4\uC694. \uB3C4\uB11B\uC5D0 \uB530\uB73B\uD55C \uCEE4\uD53C\uB77C\uB2C8\u2026
    \uBC8C\uC368 \uAE30\uB300\uB3FC\uC694!"
  - "Hallo! Ich habe auch von diesem Ort geh\xF6rt. Donuts und warmer Kaffee\u2026
    ich freue mich wirklich darauf!"
