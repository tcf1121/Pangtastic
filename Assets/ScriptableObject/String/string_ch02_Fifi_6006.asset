  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_ch02_Fifi_6006
  m_EditorClassIdentifier: 
  ID: string_ch02_Fifi_6006
  value:
  - "Now that the caf\xE9 is settled, the next step is a bakery. We need a wider
    variety of breads so customers will keep coming back."
  - 
  - 
  - "\u597D\u4E86\uFF0C\u5496\u5561\u9986\u7AD9\u7A33\u811A\u8DDF\u540E\uFF0C\u63A5\u4E0B\u6765\u8BE5\u5F00\u9762\u5305\u5E97\u4E86\u3002\u53EA\u6709\u63D0\u4F9B\u66F4\u591A\u79CD\u7C7B\u7684\u9762\u5305\uFF0C\u624D\u80FD\u8BA9\u5BA2\u4EBA\u6301\u7EED\u5149\u987E\u3002"
  - "\u597D\uFF0C\u5496\u5561\u5EF3\u7AD9\u7A69\u8173\u8DDF\u5F8C\uFF0C\u63A5\u4E0B\u4F86\u662F\u9EB5\u5305\u574A\u3002\u53EA\u6709\u63D0\u4F9B\u66F4\u591A\u6A23\u5316\u7684\u9EB5\u5305\uFF0C\u5BA2\u4EBA\u624D\u6703\u6301\u7E8C\u5149\u9867\u3002"
  - "\u3055\u3042\u3001\u30AB\u30D5\u30A7\u3082\u843D\u3061\u7740\u3044\u3066\u304D\u305F\u3057\u6B21\u306F\u30D1\u30F3\u5C4B\u3060\u306D\u3002\u3082\u3063\u3068\u69D8\u3005\u306A\u30D1\u30F3\u304C\u3042\u308C\u3070\u3001\u304A\u5BA2\u3055\u3093\u304C\u4F55\u5EA6\u3082\u6765\u3066\u304F\u308C\u308B\u3060\u308D\u3046\u304B\u3089"
  - "\uC790, \uC774\uC81C \uCE74\uD398\uB3C4 \uC790\uB9AC\uB97C \uC7A1\uC558\uC73C\uB2C8
    \uB2E4\uC74C\uC740 \uBE75\uC9D1\uC774\uC57C. \uB354 \uB2E4\uC591\uD55C \uBE75\uC774
    \uC788\uC5B4\uC57C \uC190\uB2D8\uB4E4\uC774 \uACC4\uC18D \uCC3E\uC544\uC62C \uD14C\uB2C8\uAE4C."
