  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_ch08_Fifi_6003
  m_EditorClassIdentifier: 
  ID: string_ch08_Fifi_6003
  value:
  - "\u201CYour wish and your grandfather's dream have been fulfilled here. This
    street will be remembered by everyone from now on.\u201D"
  - 
  - 
  - "\u4F60\u7684\u613F\u671B\uFF0C\u7237\u7237\u7684\u68A6\u60F3\uFF0C\u90FD\u5728\u8FD9\u91CC\u5B9E\u73B0\u4E86\u3002\u8FD9\u6761\u8857\u5C06\u6C38\u8FDC\u88AB\u6240\u6709\u4EBA\u94ED\u8BB0\u3002"
  - "\u4F60\u7684\u5FC3\u9858\uFF0C\u723A\u723A\u7684\u5922\u60F3\uFF0C\u90FD\u5728\u6B64\u5713\u6EFF\u5BE6\u73FE\u3002\u9019\u689D\u8857\u5C07\u88AB\u6240\u6709\u4EBA\u9298\u8A18\u3002"
  - "\u541B\u306E\u9858\u3044\u3082\u3001\u304A\u3058\u3044\u3061\u3083\u3093\u306E\u5922\u3082\u3053\u3053\u3067\u53F6\u3063\u305F\u3002\u3053\u306E\u901A\u308A\u306F\u3053\u308C\u304B\u3089\u3001\u307F\u3093\u306A\u306B\u8A18\u61B6\u3055\u308C\u308B\u3060\u308D\u3046\u3002"
  - "\uB124 \uC18C\uB9DD\uB3C4, \uD560\uC544\uBC84\uC9C0\uC758 \uAFC8\uB3C4 \uC5EC\uAE30\uC11C
    \uC644\uC131\uB410\uC5B4. \uC774 \uAC70\uB9AC\uB294 \uC774\uC81C \uBAA8\uB450\uC5D0\uAC8C
    \uAE30\uC5B5\uB420 \uAC70\uC57C."
  - "Dein Wunsch und der Traum deines Gro\xDFvaters haben sich erf\xFCllt. Alle werden
    sich von jetzt an an diese Stra\xDFe erinnern."
  - 
