  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_ch03_Milo_6001
  m_EditorClassIdentifier: 
  ID: string_ch03_Milo_6001
  value:
  - "\u201CHmm\u2026 I'm here to check out the cake. I don\u2019t have high expectations,
    but if it\u2019s good, I might come back again.\u201D"
  - 
  - "Hmm\u2026 Ich bin hier, um den Kuchen zu probieren. Ich erwarte nicht viel,
    aber wenn er gut ist, komm ich vielleicht wieder."
  - "\u55EF\u2026\u6211\u662F\u6765\u5C1D\u5C1D\u86CB\u7CD5\u5473\u9053\u7684\u3002\u4E0D\u62B1\u671F\u5F85\uFF0C\u4F46\u8981\u662F\u597D\u5403\u7684\u8BDD\u8BF4\u4E0D\u5B9A\u8FD8\u4F1A\u518D\u6765\u3002"
  - "\u55EF\u2026\u6211\u662F\u4F86\u8A66\u8A66\u86CB\u7CD5\u53E3\u5473\u7684\u3002\u6C92\u62B1\u671F\u5F85\u5566\uFF0C\u4F46\u8981\u662F\u597D\u5403\u8AAA\u4E0D\u5B9A\u9084\u6703\u518D\u4F86\u3002"
  - "\u3075\u3080\u2026\u30B1\u30FC\u30AD\u306E\u5473\u3092\u78BA\u8A8D\u3057\u306B\u6765\u305F\u3093\u3060\u3002\u671F\u5F85\u306F\u3057\u3066\u306A\u3044\u3051\u3069\u3001\u7F8E\u5473\u3057\u304B\u3063\u305F\u3089\u307E\u305F\u6765\u308B\u304B\u3082\u3002"
  - "\uD750\uC74C\u2026 \uCF00\uC774\uD06C \uB9DB \uC880 \uD655\uC778\uD558\uB7EC
    \uC654\uC9C0. \uAE30\uB300\uB294 \uC548 \uD558\uB294\uB370, \uB9DB\uC788\uC73C\uBA74
    \uB610 \uC62C\uC9C0\uB3C4."
  - "Hmm\u2026 Ich bin hier, um den Kuchen zu probieren. Ich erwarte nicht viel,
    aber wenn er gut ist, komm ich vielleicht wieder."
