  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_prologue_meow_6001
  m_EditorClassIdentifier: 
  ID: string_prologue_meow_6001
  value:
  - "\u201CSo this is\u2026 the store. I still remember the taste of the donuts I
    had as a child. If I could bring this place back to life\u2026 I could bring
    back smiles to people\u2019s faces.\u201D"
  - 
  - 
  - "\u539F\u6765\u8FD9\u91CC\u5C31\u662F\u2026\u2026\u90A3\u5BB6\u5E97\u554A\u3002\u513F\u65F6\u5403\u8FC7\u7684\u751C\u751C\u5708\u5473\u9053\uFF0C\u81F3\u4ECA\u4ECD\u8BB0\u5FC6\u72B9\u65B0\u3002\u82E5\u80FD\u8BA9\u8FD9\u91CC\u91CD\u7115\u751F\u673A\u2026\u2026\u5B9A\u80FD\u4E3A\u4EBA\u4EEC\u5E26\u56DE\u7B11\u5BB9\u5427\u3002\u201D "
  - "\u539F\u4F86\u9019\u88E1\u5C31\u662F\u2026\u90A3\u9593\u5E97\u554A\u3002\u5152\u6642\u5403\u904E\u7684\u751C\u751C\u5708\u6ECB\u5473\uFF0C\u81F3\u4ECA\u4ECD\u8A18\u61B6\u7336\u65B0\u3002\u82E5\u80FD\u8B93\u9019\u5730\u65B9\u91CD\u632F\u65D7\u9F13\u2026\u6216\u8A31\u5C31\u80FD\u628A\u7B11\u5BB9\u9084\u7D66\u4EBA\u5011\u5427\u3002\u300D "
  - "\u3053\u3053\u304C\u2026\u3042\u306E\u5E97\u304B\u3002\u5B50\u4F9B\u306E\u9803\u306B\u98DF\u3079\u305F\u30C9\u30FC\u30CA\u30C4\u306E\u5473\u3001\u4ECA\u3067\u3082\u899A\u3048\u3066\u3044\u308B\u3002\u518D\u3073\u3053\u306E\u5E97\u3092\u7ACB\u3066\u76F4\u305B\u308C\u3070\u2026\u4EBA\u3005\u306B\u7B11\u9854\u3092\u53D6\u308A\u623B\u305B\u308B\u3060\u308D\u3046\u3002\u300D "
  - " \u201C\uC5EC\uAE30\uAC00 \uBC14\uB85C\u2026 \uADF8 \uAC00\uAC8C\uAD6C\uB098.
    \uC5B4\uB9B4 \uB54C \uBA39\uC5C8\uB358 \uB3C4\uB11B \uB9DB, \uC544\uC9C1\uB3C4
    \uAE30\uC5B5\uB098. \uB2E4\uC2DC \uC774\uACF3\uC744 \uC77C\uC73C\uCF1C \uC138\uC6B4\uB2E4\uBA74\u2026
    \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uC6C3\uC74C\uC744 \uB3CC\uB824\uC904 \uC218 \uC788\uACA0\uC9C0.\u201D "
  - 
  - 
