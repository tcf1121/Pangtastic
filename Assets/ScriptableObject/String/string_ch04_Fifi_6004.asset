  - "\u53C8\u662F\u8FD9\u79CD\u8BF4\u8BDD\u65B9\u5F0F\u3002\u8BF4\u5230\u8FD9\u79CD\u7A0B\u5EA6\uFF0C\u6211\u7B80\u76F4\u597D\u5947\u5F97\u8981\u6B7B\u4F60\u7684\u2018\u5FAE\u5C0F\u5F00\u59CB\u2019\u5230\u5E95\u662F\u4EC0\u4E48\uFF1F"
  - "\u53C8\u662F\u9019\u7A2E\u8AAA\u8A71\u65B9\u5F0F\u3002\u8AAA\u5230\u9019\u88E1\uFF0C\u6211\u7C21\u76F4\u597D\u5947\u5F97\u8981\u6B7B\uFF0C\u4F60\u7684\u300E\u5FAE\u5C0F\u958B\u59CB\u300F\u7A76\u7ADF\u662F\u4EC0\u9EBC\uFF1F"
  - "\u307E\u305F\u305D\u306E\u53E3\u8ABF\u306D\u3002\u3053\u3053\u307E\u3067\u6765\u308B\u3068\u3001\u541B\u306E\u300E\u5C0F\u3055\u306A\u59CB\u307E\u308A\u300F\u304C\u4F55\u304B\u6C17\u306B\u306A\u3063\u3066\u4ED5\u65B9\u306A\u3044\u306E\u3088\uFF1F"
  - "\uB610 \uADF8\uB7F0 \uB9D0\uD22C\uB2E4. \uC774\uCBE4 \uB418\uBA74 \uB124 \u2018\uC791\uC740
