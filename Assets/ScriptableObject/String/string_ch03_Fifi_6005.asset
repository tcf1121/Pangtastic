  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_ch03_Fifi_6005
  m_EditorClassIdentifier: 
  ID: string_ch03_Fifi_6005
  value:
  - "Now, this is a proper high-class cafe. Look at the customers\u2019 faces. you
    can see how grateful they are to you.\u201D"
  - 
  - 
  - "\u77A7\uFF0C\u73B0\u5728\u53EF\u662F\u540D\u526F\u5176\u5B9E\u7684\u9AD8\u7EA7\u5496\u5561\u9986\u4E86\u3002\u770B\u770B\u5BA2\u4EBA\u4EEC\u7684\u8868\u60C5\uFF0C\u6EE1\u8138\u90FD\u662F\u5BF9\u4F60\u7684\u611F\u6FC0\u3002"
  - "\u77A7\uFF0C\u73FE\u5728\u53EF\u662F\u6B63\u7D93\u7684\u9AD8\u7D1A\u5496\u5561\u5EF3\u4E86\u3002\u770B\u770B\u5BA2\u4EBA\u5011\u7684\u81C9\u8272\uFF0C\u6EFF\u6EFF\u90FD\u662F\u5C0D\u4F60\u7684\u611F\u6FC0\u5462\u3002"
  - "\u3055\u3042\u3001\u3053\u308C\u3067\u672C\u683C\u7684\u306A\u9AD8\u7D1A\u30AB\u30D5\u30A7\u3060\u3002\u304A\u5BA2\u3055\u3093\u306E\u8868\u60C5\u3092\u898B\u3066\u3054\u3089\u3093\u3002\u541B\u306B\u611F\u8B1D\u3057\u3066\u3044\u308B\u306E\u304C\u5168\u90E8\u308F\u304B\u308B\u3088\u3002"
  - "\uC790, \uC774\uC81C\uB294 \uC81C\uB300\uB85C \uB41C \uACE0\uAE09 \uCE74\uD398\uC57C.
    \uC190\uB2D8\uB4E4 \uD45C\uC815 \uC880 \uBD10. \uB108\uD55C\uD14C \uACE0\uB9C8\uC6CC\uD558\uB294
    \uAC8C \uB2E4 \uBCF4\uC778\uB2E4."
  - "Also das nenn ich ein richtiges Caf\xE9. Guck dir die Gesichter der Kunden an.
    Man kann sehen, wie dankbar sie dir sind."
  - 
  - 
