  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_ch04_meow_6005
  m_EditorClassIdentifier: 
  ID: string_ch04_meow_6005
  value:
  - "\u201C\u2026Actually, there\u2019s a very precious memory here for me. That
    memory keeps drawing me back.\u201D"
  - 
  - 
  - "\u2026\u2026\u5176\u5B9E\uFF0C\u8FD9\u91CC\u85CF\u7740\u6211\u6700\u73CD\u8D35\u7684\u56DE\u5FC6\u3002\u90A3\u6BB5\u8BB0\u5FC6\u603B\u5728\u7275\u5F15\u7740\u6211\u3002"
  - "\u2026\u5176\u5BE6\uFF0C\u9019\u88E1\u85CF\u8457\u6211\u6700\u73CD\u8CB4\u7684\u56DE\u61B6\u3002\u90A3\u4EFD\u8A18\u61B6\u7E3D\u662F\u4E0D\u65B7\u727D\u5F15\u8457\u6211\u3002"
  - "\u2026\u5B9F\u306F\u3001\u3053\u3053\u306B\u50D5\u306B\u3068\u3063\u3066\u3068\u3066\u3082\u5927\u5207\u306A\u601D\u3044\u51FA\u304C\u3042\u308B\u3093\u3060\u3002\u305D\u306E\u601D\u3044\u51FA\u304C\u50D5\u3092\u4F55\u5EA6\u3082\u5F15\u304D\u5BC4\u305B\u308B\u3093\u3060\u3002"
  - "\u2026\uC0AC\uC2E4, \uC5EC\uAE30\uC5D0 \uB0B4\uAC8C \uC544\uC8FC \uC18C\uC911\uD55C
    \uAE30\uC5B5\uC774 \uC788\uC5B4. \uADF8 \uAE30\uC5B5\uC774 \uB098\uB97C \uC790\uAFB8
    \uC774\uB04C\uC5B4."
  - 
  - 
  - 
