  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_ch03_meow_6006
  m_EditorClassIdentifier: 
  ID: string_ch03_meow_6006
  value:
  - "\u201C\u2026I\u2019ll tell you someday. I just can\u2019t put it into words
    yet.\u201D"
  - 
  - 
  - "\u2026\u603B\u6709\u4E00\u5929\u4F1A\u8BF4\u7684\u3002\u53EA\u662F\u73B0\u5728\u8FD8\u6CA1\u6574\u7406\u597D\u601D\u7EEA\u3002"
  - "\u2026\u2026\u7E3D\u6709\u4E00\u5929\u6703\u544A\u8A34\u4F60\u7684\u3002\u53EA\u662F\u73FE\u5728\u9084\u7121\u6CD5\u6574\u7406\u6E05\u695A\u3002"
  - "\u2026\u3044\u3064\u304B\u8A71\u3059\u3088\u3002\u307E\u3060\u6574\u7406\u304C\u3064\u304B\u306A\u304F\u3066\u3002"
  - "\u2026\uC5B8\uC820\uAC00\uB294 \uB9D0\uD560\uAC8C. \uC544\uC9C1\uC740 \uC815\uB9AC\uD560
    \uC218\uAC00 \uC5C6\uC5B4\uC11C."
  - "\u2026 Ich werde es dir irgendwann erz\xE4hlen. Ich kann es noch nicht ganz
    in Worte fassen."
  - 
  - 
  - 
  - 
  - 
