  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_Fifi_6003
  m_EditorClassIdentifier: 
  ID: string_Fifi_6003
  value:
  - "\u201CYes, that\u2019s right! If this shop comes back to life\u2026 someday
    this whole street will regain its energy. And maybe, someday, people from all
    over the world will come to visit.\u201D"
  - 
  - 
  - "\u662F\u554A\uFF0C\u6CA1\u9519\uFF01\u5982\u679C\u8FD9\u5BB6\u5E97\u6062\u590D\u751F\u673A\u2026\u2026\u603B\u6709\u4E00\u5929\uFF0C\u8FD9\u6761\u8857\u4E5F\u4F1A\u70ED\u95F9\u8D77\u6765\u3002\u8BF4\u4E0D\u5B9A\u54EA\u5929\uFF0C\u4E16\u754C\u5404\u5730\u7684\u4EBA\u90FD\u4F1A\u6765\u8FD9\u91CC\u3002"
  - 
  - " \u300C\u3046\u3093\u3001\u305D\u3046\u3060\uFF01\u3053\u306E\u304A\u5E97\u304C\u307E\u305F\u751F\u304D\u3066\u3044\u3051\u3070\u2026\u3044\u3064\u304B\u3053\u306E\u8857\u5168\u4F53\u3082\u6D3B\u6C17\u3092\u53D6\u308A\u623B\u3059\u3060\u308D\u3046\u3002\u305D\u3057\u3066\u3044\u3064\u306E\u9593\u306B\u4E16\u754C\u4E2D\u306E\u4EBA\u3005\u304C\u3053\u3053\u3092\u8A2A\u308C\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u304B\uFF1F\u300D "
  - " \u201C\uC751, \uB9DE\uC544! \uC774 \uAC00\uAC8C\uAC00 \uB2E4\uC2DC \uC0B4\uC544\uB098\uBA74\u2026
    \uC5B8\uC820\uAC00 \uC774 \uAC70\uB9AC \uC804\uCCB4\uB3C4 \uD65C\uAE30\uB97C
    \uB418\uCC3E\uC744 \uAC70\uC57C. \uADF8\uB9AC\uACE0 \uC5B8\uC820\uAC04 \uC804
    \uC138\uACC4 \uC0AC\uB78C\uB4E4\uC774 \uC774\uACF3\uC744 \uCC3E\uC544\uC62C \uC218\uB3C4
    \uC788\uC9C0 \uC54A\uC744\uAE4C?\u201D "
  - 
