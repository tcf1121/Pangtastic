  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_ch02_meow_6004
  m_EditorClassIdentifier: 
  ID: string_ch02_meow_6004
  value:
  - "\u201C\u2026\u2026I can\u2019t tell you yet. I promise I\u2019ll tell you when
    the time is right.\u201D"
  - 
  - 
  - "\u2026\u2026\u73B0\u5728\u8FD8\u4E0D\u80FD\u8BF4\u3002\u65F6\u673A\u5230\u4E86\u6211\u4E00\u5B9A\u4F1A\u544A\u8BC9\u4F60\u7684"
  - "\u2026\u2026\u73FE\u5728\u9084\u4E0D\u80FD\u8AAA\u3002\u6642\u6A5F\u5230\u4E86\u6211\u4E00\u5B9A\u6703\u544A\u8A34\u4F60"
  - "\u2026\u2026\u307E\u3060\u8A00\u3048\u306A\u3044\u3002\u6642\u304C\u6765\u305F\u3089\u5FC5\u305A\u8A71\u3059\u304B\u3089"
  - " \u201C\u2026\u2026\uC544\uC9C1\uC740 \uB9D0\uD574\uC904 \uC218 \uC5C6\uC5B4.
    \uB54C\uAC00 \uB418\uBA74 \uBC18\uB4DC\uC2DC \uB9D0\uD574\uC904\uAC8C"
  - "\u2026\u2026 Das kann ich dir noch nicht sagen. Ich verspreche dir, ich werde
    es dir zur richtigen Zeit erz\xE4hlen."
  - 
  - 
  - 
  - 
  - 
