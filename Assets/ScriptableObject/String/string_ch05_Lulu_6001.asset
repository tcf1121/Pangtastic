  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_ch05_Lulu_6001
  m_EditorClassIdentifier: 
  ID: string_ch05_Lulu_6001
  value:
  - "\u201CHello~ I heard the rumors! This time it\u2019s a bakery. I\u2019m really
    looking forward to it!\u201D"
  - 
  - "Hello! Ich habe die Gr\xFCchte geh\xF6rt! Diesmal ist es eine B\xE4ckerei. Ich
    freue mich sehr darauf!"
  - "\u4F60\u597D\u5440~\u542C\u95FB\u76DB\u540D\u4E13\u7A0B\u800C\u6765\uFF01\u8FD9\u6B21\u5C45\u7136\u662F\u9762\u5305\u5E97\uFF0C\u592A\u671F\u5F85\u4E86\uFF01"
  - "\u55E8\uFF5E\u807D\u8AAA\u4E86\u5C31\u8DD1\u4F86\u4E86\uFF01\u9019\u6B21\u5C45\u7136\u662F\u9EB5\u5305\u5E97\uFF0C\u8D85\u671F\u5F85\u7684\uFF01"
  - "\u3084\u3042\uFF5E\u5642\u3092\u805E\u3044\u3066\u6765\u305F\u3088\uFF01\u4ECA\u5EA6\u306F\u30D1\u30F3\u5C4B\u3060\u306A\u3093\u3066\u3001\u672C\u5F53\u306B\u697D\u3057\u307F\uFF01"
  - "\uC548\uB155~ \uC18C\uBB38 \uB4E3\uACE0 \uC654\uC5B4! \uC774\uBC88\uC5D4 \uBE75\uC9D1\uC774\uB77C\uB2C8,
    \uC9C4\uC9DC \uAE30\uB300\uB3FC!"
  - "Hello! Ich habe die Gr\xFCchte geh\xF6rt! Diesmal ist es eine B\xE4ckerei. Ich
    freue mich sehr darauf!"
