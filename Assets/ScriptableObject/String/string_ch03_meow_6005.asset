  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_ch03_meow_6005
  m_EditorClassIdentifier: 
  ID: string_ch03_meow_6005
  value:
  - "\u201CHmm\u2026 It feels strange to see such liveliness. I\u2019ve seen this
    kind of scenery before.\u201D"
  - 
  - "Hmm\u2026 es f\xFChlt sich komisch an so viel Leben zu sehen. Diese Bild kommt
    mir bekannt vor."
  - "\u55EF\u2026\u2026\u770B\u5230\u8FD9\u822C\u70ED\u95F9\u7684\u666F\u8C61\uFF0C\u5FC3\u60C5\u5F88\u590D\u6742\u3002\u4EE5\u524D\u4E5F\u89C1\u8FC7\u8FD9\u6837\u7684\u573A\u666F\u5462\u3002"
  - "\u55EF\u2026\u770B\u8457\u9019\u822C\u71B1\u9B27\u7684\u666F\u8C61\uFF0C\u5FC3\u60C5\u83AB\u540D\u8907\u96DC\u3002\u7562\u7ADF\u4EE5\u524D\u4E5F\u898B\u904E\u9019\u6A23\u7684\u5149\u666F\u3002"
  - "\u3075\u3080\u2026\u3053\u3093\u306A\u306B\u6D3B\u6C17\u3042\u308B\u306E\u3092\u898B\u308B\u3068\u3001\u5999\u306A\u6C17\u5206\u306B\u306A\u308B\u3002\u6614\u3082\u3053\u3093\u306A\u5149\u666F\u3092\u898B\u305F\u3053\u3068\u304C\u3042\u308B\u3093\u3060\u3002"
  - "\uD750\uC74C\u2026 \uC774\uB807\uAC8C \uD65C\uAE30\uCC2C \uAC78 \uBCF4\uB2C8\uAE4C
    \uAE30\uBD84\uC774 \uBB18\uD574. \uC608\uC804\uC5D0\uB3C4 \uC774\uB7F0 \uD48D\uACBD\uC744
    \uBCF8 \uC801\uC774 \uC788\uAC70\uB4E0."
  - "Hmm\u2026 es f\xFChlt sich komisch an so viel Leben zu sehen. Diese Bild kommt
    mir bekannt vor."
