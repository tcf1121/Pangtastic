  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_narration_6001
  m_EditorClassIdentifier: 
  ID: string_narration_6001
  value:
  - "\u201CThis street was once filled with a sweet aroma long ago. People always
    gathered with smiles, and this small shop was the heart of the neighborhood.\u201D"
  - 
  - 
  - "\u5F88\u4E45\u4EE5\u524D\uFF0C\u8FD9\u6761\u8857\u4E0A\u5F25\u6F2B\u7740\u751C\u7F8E\u7684\u9999\u6C14\u3002\u4EBA\u4EEC\u603B\u662F\u9762\u5E26\u5FAE\u7B11\u5730\u805A\u96C6\u5728\u4E00\u8D77\uFF0C\u800C\u8FD9\u5BB6\u5C0F\u5E97\u5C31\u662F\u8857\u533A\u7684\u4E2D\u5FC3\u3002"
  - 
  - " \u300C\u3053\u3053\u306F\u305A\u3063\u3068\u524D\u3001\u7518\u3044\u9999\u308A\u3067\u3044\u3063\u3071\u3044\u3060\u3063\u305F\u8857\u3002\u4EBA\u3005\u306F\u3044\u3064\u3082\u7B11\u3063\u3066\u96C6\u307E\u308A\u3001\u3053\u306E\u5C0F\u3055\u306A\u304A\u5E97\u304C\u8FD1\u6240\u306E\u4E2D\u5FC3\u3067\u3057\u305F\u306D"
  - " \u201C\uC774\uACF3\uC740 \uC624\uB798\uC804, \uB2EC\uCF64\uD55C \uD5A5\uAE30\uB85C
    \uAC00\uB4DD\uD588\uB358 \uAC70\uB9AC. \uC0AC\uB78C\uB4E4\uC740 \uB298 \uC6C3\uC73C\uBA70
    \uBAA8\uC5EC\uB4E4\uC5C8\uACE0, \uC774 \uC791\uC740 \uAC00\uAC8C\uAC00 \uB3D9\uB124\uC758
    \uC911\uC2EC\uC774\uC5C8\uC8E0."
  - 
  - 
