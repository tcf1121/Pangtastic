  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_ch03_Fifi_6002
  m_EditorClassIdentifier: 
  ID: string_ch03_Fifi_6002
  value:
  - "\u201CForget the empty menu. what really needs filling is that smile of yours.
    Relax, your hands already work like a veteran.\u201D"
  - 
  - 
  - "\u7A7A\u8361\u8361\u7684\u4E0D\u662F\u83DC\u5355\u800C\u662F\u4F60\u90A3\u5F20\u8138\u5427\uFF1F\u653E\u677E\u70B9\uFF0C\u4F60\u8FD9\u53CC\u624B\u65E9\u5C31\u662F\u8001\u624B\u4E86\u3002"
  - "\u7A7A\u8569\u8569\u7684\u4E0D\u662F\u83DC\u55AE\uFF0C\u662F\u4F60\u81C9\u4E0A\u90A3\u526F\u8868\u60C5\u5427\uFF1F\u653E\u9B06\u9EDE\uFF0C\u4F60\u7684\u624B\u85DD\u65E9\u5DF2\u662F\u8001\u624B\u4E86\u3002"
  - "\u5BC2\u3057\u3044\u306E\u306F\u30E1\u30CB\u30E5\u30FC\u8868\u3058\u3083\u306A\u304F\u3066\u3001\u541B\u306E\u9854\u3058\u3083\u306A\u3044\uFF1F\u7DCA\u5F35\u3092\u89E3\u3044\u3066\u3002\u541B\u306E\u624B\u306F\u3059\u3067\u306B\u30D9\u30C6\u30E9\u30F3\u3060\u3088"
  - "\uD5C8\uC804\uD55C \uAC74 \uBA54\uB274\uD310\uC774 \uC544\uB2C8\uB77C \uB124
    \uC5BC\uAD74 \uAC19\uC740\uB370? \uAE34\uC7A5 \uD480\uC5B4. \uB124 \uC190\uC740
    \uC774\uBBF8 \uBCA0\uD14C\uB791\uC774\uC57C."
  - "Vergiss das leere Men\xFC. Was wirklich gef\xFCllt werden muss, ist dein Lachen.
    Entspann dich, deine H\xE4nde arbeiten schon wie von selbst."
  - 
  - 
