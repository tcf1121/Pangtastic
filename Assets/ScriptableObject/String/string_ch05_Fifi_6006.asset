  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_ch05_Fifi_6006
  m_EditorClassIdentifier: 
  ID: string_ch05_Fifi_6006
  value:
  - "\u201C\u2026You finally gave me a hint. I think I understand a little why you\u2019re
    so obsessed with this street.\u201D"
  - 
  - 
  - "\u2026\u2026\u603B\u7B97\u900F\u9732\u70B9\u7EBF\u7D22\u4E86\u3002\u6211\u5927\u6982\u660E\u767D\u4F60\u4E3A\u4F55\u6267\u7740\u4E8E\u8FD9\u6761\u8857\u4E86\u3002"
  - "\u2026\u7E3D\u7B97\u7D66\u9EDE\u63D0\u793A\u4E86\u3002\u6211\u5927\u6982\u660E\u767D\u4F60\u70BA\u4F55\u57F7\u8457\u65BC\u9019\u689D\u8857\u4E86\u3002"
  - "\u2026\u3088\u3046\u3084\u304F\u30D2\u30F3\u30C8\u3092\u304F\u308C\u305F\u306A\u3002\u541B\u304C\u3053\u306E\u901A\u308A\u306B\u3053\u3060\u308F\u308B\u7406\u7531\u304C\u3001\u5C11\u3057\u306F\u5206\u304B\u3063\u305F\u6C17\u304C\u3059\u308B\u3002"
  - "\u2026\uB4DC\uB514\uC5B4 \uD78C\uD2B8\uB77C\uB3C4 \uC92C\uB124. \uB124\uAC00
    \uC65C \uC774 \uAC70\uB9AC\uC5D0 \uB9E4\uB2EC\uB9AC\uB294\uC9C0, \uC870\uAE08\uC740
    \uC54C \uAC83 \uAC19\uC544."
  - "...Du hast mir endlich einen Hinweis gegeben. Ich denke, ich verstehe ein bisschen,
    warum du so auf diese Stra\xDFe fixiert bist."
  - 
  - 
  - 
  - 
  - 
