  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_ch03_meow_6004
  m_EditorClassIdentifier: 
  ID: string_ch03_meow_6004
  value:
  - "\u201COh, no. It\u2019s just\u2026 an old memory came to mind.\u201D"
  - 
  - 
  - "\u554A\uFF0C\u4E0D\u662F\u3002\u53EA\u662F\u2026\u2026\u7A81\u7136\u60F3\u8D77\u9648\u5E74\u5F80\u4E8B\u7F62\u4E86\u3002"
  - "\u554A\uFF0C\u4E0D\u662F\u5566\u3002\u53EA\u662F\u2026\u7A81\u7136\u60F3\u8D77\u9673\u5E74\u5F80\u4E8B\u7F77\u4E86\u3002"
  - "\u3042\u3001\u9055\u3046\u3088\u3002\u305F\u3060\u2026\u53E4\u3044\u8A18\u61B6\u304C\u3088\u307F\u304C\u3048\u3063\u305F\u3060\u3051\u3055\u3002"
  - "\uC544, \uC544\uB2C8\uC57C. \uADF8\uB0E5\u2026 \uC624\uB798\uB41C \uAE30\uC5B5\uC774
    \uB0AC\uC744 \uBFD0\uC774\uC57C."
  - "Ach, nichts. Es ist nur\u2026 eine alte Erinnerung kam mir in den Sinn."
  - 
  - 
