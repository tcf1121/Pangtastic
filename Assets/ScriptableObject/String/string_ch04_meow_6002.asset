  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_ch04_meow_6002
  m_EditorClassIdentifier: 
  ID: string_ch04_meow_6002
  value:
  - "\u201CHey\u2026 I can\u2019t take that kind of joke. Anyway, I\u2019ll prepare
    thoroughly.\u201D"
  - 
  - 
  - "\u54CE\u2026\u8FD9\u79CD\u73A9\u7B11\u53EF\u53D7\u4E0D\u4E86\u3002\u603B\u4E4B\u51C6\u5907\u5DE5\u4F5C\u4F1A\u505A\u5F97\u5F88\u5468\u5168\u3002"
  - " \u54CE\u2026\u9019\u7A2E\u73A9\u7B11\u6211\u53EF\u62DB\u67B6\u4E0D\u4F4F\u3002\u7E3D\u4E4B\u6E96\u5099\u5DE5\u4F5C\u6703\u4ED4\u7D30\u505A\u597D\u7684\u3002"
  - "\u3048\u30FC\u2026\u305D\u3093\u306A\u5197\u8AC7\u306F\u53D7\u3051\u6B62\u3081\u3089\u308C\u306A\u3044\u3088\u3002\u3068\u306B\u304B\u304F\u6E96\u5099\u306F\u5165\u5FF5\u306B\u3059\u308B\u3064\u3082\u308A\u3060\u3002"
  - "\uC5D0\uC774\u2026 \uADF8\uB7F0 \uB18D\uB2F4\uC740 \uBABB \uB2F9\uD558\uACA0\uB124.
    \uC5B4\uCA0C\uB4E0 \uC900\uBE44\uB294 \uAF3C\uAF3C\uD788 \uD560 \uAC70\uC57C."
  - "Hey, ich kann diese Art von Scherz nicht ausstehen. Wie auch immer, ich werde
    mich sorgf\xE4ltig vorbereiten."
  - 
