  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_prologue_Fifi_6002
  m_EditorClassIdentifier: 
  ID: string_prologue_Fifi_6002
  value:
  - "\u201CIt might be tough alone, but together, we can do it! Let\u2019s refill
    it little by little.\u201D"
  - 
  - "Alleine k\xF6nnte es schwer sein, aber zusammen k\xF6nnen wir es schaffen! Lass
    uns alles Schritt f\xFCr Schritt f\xFCllen."
  - "\u72EC\u81EA\u4E00\u4EBA\u6216\u8BB8\u8270\u96BE\uFF0C\u4F46\u6211\u4EEC\u4E24\u4EBA\u5B9A\u80FD\u505A\u5230\uFF01\u8BA9\u6211\u4EEC\u4E00\u6B65\u6B65\u91CD\u65B0\u586B\u6EE1\u8FD9\u91CC\u5427\u3002"
  - "\u7368\u81EA\u4E00\u4EBA\u6216\u8A31\u8271\u96E3\uFF0C\u4F46\u6211\u5011\u5169\u4EBA\u5C31\u80FD\u8FA6\u5230\uFF01\u8B93\u6211\u5011\u4E00\u6B65\u6B65\u91CD\u65B0\u586B\u6EFF\u9019\u88E1\u5427\u3002"
  - "\u4E00\u4EBA\u3058\u3083\u5927\u5909\u3060\u3051\u3069\u3001\u4E8C\u4EBA\u306A\u3089\u3067\u304D\u308B\uFF01\u4E00\u3064\u305A\u3064\u3001\u4E01\u5BE7\u306B\u307E\u305F\u6E80\u305F\u3057\u3066\u3044\u3053\u3046\u3002"
  - "\uD63C\uC790\uB77C\uBA74 \uD798\uB4E4\uACA0\uC9C0\uB9CC, \uC6B0\uB9AC \uB458\uC774\uB77C\uBA74
    \uD560 \uC218 \uC788\uC5B4! \uD558\uB098\uC529 \uCC28\uADFC\uCC28\uADFC \uB2E4\uC2DC
    \uCC44\uC6CC\uB098\uAC00\uC790."
  - "Alleine k\xF6nnte es schwer sein, aber zusammen k\xF6nnen wir es schaffen! Lass
    uns alles Schritt f\xFCr Schritt f\xFCllen."
  - 
  - 
