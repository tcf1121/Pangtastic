  m_Script: {fileID: 11500000, guid: 2d237f1653b596b40b5c55eb385172e7, type: 3}
  m_Name: string_ch04_Fifi_6003
  m_EditorClassIdentifier: 
  ID: string_ch04_Fifi_6003
  value:
  - "\u201CSeeing the customers, I feel like I\u2019ve already succeeded even though
    I\u2019m only halfway done.\u201D"
  - 
  - "Wenn ich die Kunden sehe, bekomme ich das Gef\xFChl ich habe es schon geschafft,
    obwohl ich erst halbfertig bin."
  - "\u770B\u7740\u5BA2\u4EBA\u4EEC\u7684\u53CD\u5E94\uFF0C\u5C31\u7B97\u53EA\u5B8C\u6210\u4E00\u534A\u4E5F\u611F\u89C9\u6210\u529F\u4E86\u5462\u3002"
  - "\u770B\u8457\u5BA2\u4EBA\u5011\uFF0C\u5149\u5B8C\u6210\u4E00\u534A\u5C31\u611F\u89BA\u5DF2\u7D93\u6210\u529F\u4E86\u5462\u3002"
  - "\u304A\u5BA2\u3055\u3093\u305F\u3061\u3092\u898B\u308B\u3068\u3001\u534A\u5206\u5B8C\u6210\u3057\u305F\u3060\u3051\u3067\u3082\u3082\u3046\u6210\u529F\u3057\u305F\u6C17\u5206\u3060\u308F\u3002"
  - "\uC190\uB2D8\uB4E4 \uBCF4\uB2C8\uAE4C \uBC18\uB9CC \uC644\uC131\uD574\uB3C4
    \uBC8C\uC368 \uC131\uACF5\uD55C \uB290\uB08C\uC774\uB124."
  - "Wenn ich die Kunden sehe, bekomme ich das Gef\xFChl ich habe es schon geschafft,
    obwohl ich erst halbfertig bin."
  - 
  - 
