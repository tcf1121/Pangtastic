%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 29f2341bf6354eafa3b56b7abcd5cf86, type: 3}
  m_Name: String_String
  m_EditorClassIdentifier: 
  strings:
  - stringId: string_coco
    korean: "\uCF54\uCF54"
    english: Coco
    chinese: "\u53EF\u53EF"
    japanese: 
  - stringId: string_kuku
    korean: "\uCFE0\uCFE0"
    english: Kuku
    chinese: "\u5495\u5495"
    japanese: 
  - stringId: string_dialog_6001
    korean: "\uB4DC\uB514\uC5B4\u2026 \uB0B4 \uB3C4\uB11B \uAC00\uAC8C\uAC00 \uC5F4\uB838\uC5B4.
      \uD558\uC9C0\uB9CC \uD63C\uC790\uC11C \uC798 \uD574\uB0BC \uC218 \uC788\uC744\uAE4C\u2026?"
    english: "Finally\u2026 my donut shop is open. But can I really handle it all
      by myself\u2026?"
    chinese: "\u7EC8\u4E8E\u2026\u2026\u6211\u7684\u751C\u751C\u5708\u5E97\u5F00\u5F20\u4E86\u3002\u53EF\u662F\uFF0C\u6211\u771F\u7684\u80FD\u4E00\u4E2A\u4EBA\u505A\u597D\u5417\u2026\u2026\uFF1F"
    japanese: 
  - stringId: string_dialog_6002
    korean: "\uAC71\uC815 \uB9C8! \uB0B4\uAC00 \uC788\uC796\uC544 \uCF54\uCF54."
    english: "Don\u2019t worry! You\u2019ve got me, Coco."
    chinese: "\u522B\u62C5\u5FC3\uFF01\u6709\u6211\u5728\u5462\uFF0C\u79D1\u79D1\u3002"
    japanese: 
  - stringId: string_dialog_6003
    korean: "\uACE0\uB9C8\uC6CC, \uCFE0\uCFE0..."
    english: Thanks, Kuku...
    chinese: "\u8C22\u8C22\u4F60\uFF0C\u5E93\u5E93\u2026\u2026"
    japanese: 
  - stringId: string_dialog_6004
    korean: "\uB0B4\uAC00 \uC606\uC5D0\uC11C \uB3C4\uC640\uC904 \uD14C\uB2C8\uAE4C.
      \uAC19\uC774 \uBC18\uC8FD\uBD80\uD130 \uC2DC\uC791\uD558\uC790\uAD6C!"
    english: "I\u2019ll be right by your side. Let\u2019s start with the dough together!"
    chinese: "\u6211\u4F1A\u5728\u4F60\u8EAB\u8FB9\u5E2E\u5FD9\u7684\u3002\u6211\u4EEC\u5148\u4ECE\u548C\u9762\u5F00\u59CB\u5427\uFF01"
    japanese: 
  - stringId: string_dialog_6005
    korean: "\uD14C\uC2A4\uD2B8\uC6A9 \uB098\uB808\uC774\uC158 \uC785\uB2C8\uB2E4."
    english: This is a test narration.
    chinese: "\u8FD9\u662F\u6D4B\u8BD5\u7528\u7684\u65C1\u767D\u3002"
    japanese: 
  - stringId: 
    korean: 
    english: 
    chinese: 
    japanese: 
  - stringId: 
    korean: 
    english: 
    chinese: 
    japanese: 
  - stringId: 
    korean: 
    english: 
    chinese: 
    japanese: 
  - stringId: "(\uD504\uB864\uB85C\uADF8)"
    korean: 
    english: 
    chinese: 
    japanese: 
  - stringId: string_narration_6001
    korean: " \u201C\uC774\uACF3\uC740 \uC624\uB798\uC804, \uB2EC\uCF64\uD55C \uD5A5\uAE30\uB85C
      \uAC00\uB4DD\uD588\uB358 \uAC70\uB9AC. \uC0AC\uB78C\uB4E4\uC740 \uB298 \uC6C3\uC73C\uBA70
      \uBAA8\uC5EC\uB4E4\uC5C8\uACE0, \uC774 \uC791\uC740 \uAC00\uAC8C\uAC00 \uB3D9\uB124\uC758
      \uC911\uC2EC\uC774\uC5C8\uC8E0.\u201D"
    english: ' Long ago, this street was filled with sweet aromas. People always
      gathered here with smiles, and this little shop was the heart of the neighborhood.'
    chinese: "\u201C \u8FD9\u91CC\u66FE\u662F\u5145\u6EE1\u751C\u871C\u9999\u6C14\u7684\u8857\u9053\u3002\u4EBA\u4EEC\u603B\u662F\u6B22\u7B11\u7740\u805A\u96C6\u5728\u6B64\uFF0C\u8FD9\u5BB6\u5C0F\u5E97\u4FBF\u662F\u8857\u574A\u90BB\u91CC\u7684\u4E2D\u5FC3\u3002\u201D"
    japanese: 
  - stringId: string_narration_6002
    korean: "\u201C\uD558\uC9C0\uB9CC \uC2DC\uAC04\uC774 \uD750\uB974\uBA70 \uC8FC\uC778\uC740
      \uB5A0\uB0AC\uACE0, \uAC00\uAC8C\uB294 \uC78A\uD600\uC84C\uC2B5\uB2C8\uB2E4.\u201D "
    english: ' But as time passed, the owner left, and the shop was forgotten. '
    chinese: " \u201C\u7136\u800C\u65F6\u5149\u6D41\u901D\uFF0C\u5E97\u4E3B\u79BB\u53BB\uFF0C\u5E97\u94FA\u6E10\u6E10\u88AB\u4EBA\u9057\u5FD8\u3002\u201D "
    japanese: 
  - stringId: string_meow_6001
    korean: " \u201C\uC5EC\uAE30\uAC00 \uBC14\uB85C\u2026 \uADF8 \uAC00\uAC8C\uAD6C\uB098.
      \uC5B4\uB9B4 \uB54C \uBA39\uC5C8\uB358 \uB3C4\uB11B \uB9DB, \uC544\uC9C1\uB3C4
      \uAE30\uC5B5\uB098. \uB2E4\uC2DC \uC774\uACF3\uC744 \uC77C\uC73C\uCF1C \uC138\uC6B4\uB2E4\uBA74\u2026
      \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uC6C3\uC74C\uC744 \uB3CC\uB824\uC904 \uC218
      \uC788\uACA0\uC9C0.\u201D "
    english: " \u201CThis is the place... that shop. I still remember the taste of
      those doughnuts I ate as a child. If I could rebuild this place... I could
      bring smiles back to people's faces.\u201D "
    chinese: "\u201C\u8FD9\u91CC\u5C31\u662F\u2026\u2026\u90A3\u5BB6\u5E97\u554A\u3002\u5C0F\u65F6\u5019\u5403\u8FC7\u7684\u751C\u751C\u5708\u5473\u9053\uFF0C\u81F3\u4ECA\u4ECD\u8BB0\u5FC6\u72B9\u65B0\u3002\u5982\u679C\u80FD\u91CD\u65B0\u8BA9\u8FD9\u5BB6\u5E97\u7115\u53D1\u65B0\u751F\u2026\u2026\u5E94\u8BE5\u80FD\u8BA9\u4EBA\u4EEC\u91CD\u5C55\u7B11\u989C\u5427\u3002\u201D"
    japanese: 
  - stringId: string_meow_6002
    korean: "\u201C\uC9C0\uAE08\uC740 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC9C0\uB9CC\u2026
      \uC2DC\uC791\uC740 \uC791\uC740 \uD55C \uAC78\uC74C\uC774\uB2C8\uAE4C.\u201D "
    english: "\u201CThere's nothing here now... but every journey begins with a single
      step.\u201D "
    chinese: "\u201C\u73B0\u5728\u867D\u7136\u4E00\u65E0\u6240\u6709\u2026\u2026\u4F46\u5F00\u59CB\u5C31\u662F\u5C0F\u5C0F\u7684\u4E00\u6B65\u3002\u201D "
    japanese: 
  - stringId: string_Fifi_6001
    korean: " \u201C\uC5B4, \uB4DC\uB514\uC5B4 \uC654\uB124! \uB124\uAC00 \uC774
      \uAC00\uAC8C\uB97C \uB2E4\uC2DC \uC0B4\uB9B0\uB2E4\uACE0 \uD574\uC11C \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uC5C8\uC5B4.\u201D "
    english: " \u201COh, you're finally here! I've been waiting because you said
      you'd revive this shop.\u201D "
    chinese: "\u201C\u54A6\uFF0C\u7EC8\u4E8E\u6765\u4E86\uFF01\u542C\u8BF4\u4F60\u8981\u8BA9\u8FD9\u5BB6\u5E97\u91CD\u65B0\u5F00\u5F20\uFF0C\u6211\u5C31\u4E00\u76F4\u5728\u7B49\u5462\u3002\u201D "
    japanese: 
  - stringId: string_Fifi_6002
    korean: "\u201C\uD63C\uC790\uB77C\uBA74 \uD798\uB4E4\uACA0\uC9C0\uB9CC, \uC6B0\uB9AC
      \uB458\uC774\uB77C\uBA74 \uD560 \uC218 \uC788\uC5B4! \uD558\uB098\uC529 \uCC28\uADFC\uCC28\uADFC
      \uB2E4\uC2DC \uCC44\uC6CC\uB098\uAC00\uC790.\u201D"
    english: If I were alone, it would be tough, but together, we can do it! Let's
      rebuild it step by step, piece by piece..
    chinese: "\u201C\u72EC\u81EA\u4E00\u4EBA\u6216\u8BB8\u5F88\u8270\u96BE\uFF0C\u4F46\u6211\u4EEC\u4E24\u4EBA\u5C31\u80FD\u505A\u5230\uFF01\u8BA9\u6211\u4EEC\u4E00\u6B65\u4E00\u4E2A\u811A\u5370\u5730\u91CD\u65B0\u586B\u6EE1\u5B83\u5427\u3002\u201D"
    japanese: 
  - stringId: string_meow_6003
    korean: "\u201C\uACE0\uB9C8\uC6CC. \uC815\uB9D0 \uB9CE\uC740 \uB3C4\uC6C0\uC774
      \uB420 \uAC70\uC57C. \uC6B0\uC120, \uB3C4\uB11B\uBD80\uD130 \uB2E4\uC2DC \uB9CC\uB4E4\uC5B4\uC57C\uACA0\uC9C0?\u201D"
    english: Thanks. This will really help a lot. First, I guess I should make the
      donuts again?
    chinese: "\u8C22\u8C22\u3002\u8FD9\u771F\u7684\u5E2E\u4E86\u5927\u5FD9\u3002\u9996\u5148\uFF0C\u5F97\u91CD\u65B0\u505A\u751C\u751C\u5708\u5427\uFF1F"
    japanese: 
  - stringId: string_Fifi_6003
    korean: " \u201C\uC751, \uB9DE\uC544! \uC774 \uAC00\uAC8C\uAC00 \uB2E4\uC2DC
      \uC0B4\uC544\uB098\uBA74\u2026 \uC5B8\uC820\uAC00 \uC774 \uAC70\uB9AC \uC804\uCCB4\uB3C4
      \uD65C\uAE30\uB97C \uB418\uCC3E\uC744 \uAC70\uC57C. \uADF8\uB9AC\uACE0 \uC5B8\uC820\uAC04
      \uC804 \uC138\uACC4 \uC0AC\uB78C\uB4E4\uC774 \uC774\uACF3\uC744 \uCC3E\uC544\uC62C
      \uC218\uB3C4 \uC788\uC9C0 \uC54A\uC744\uAE4C?\u201D "
    english: ' Yeah, you''re right! If this shop comes back to life... someday this
      whole street will regain its vibrancy too. And who knows? Maybe someday people
      from all over the world will come to visit this place? '
    chinese: "\u201C\u55EF\uFF0C\u6CA1\u9519\uFF01\u5982\u679C\u8FD9\u5BB6\u5E97\u80FD\u91CD\u65B0\u7115\u53D1\u751F\u673A\u2026\u2026\u603B\u6709\u4E00\u5929\u6574\u6761\u8857\u90FD\u4F1A\u91CD\u73B0\u5F80\u65E5\u7684\u7E41\u8363\u3002\u8BF4\u4E0D\u5B9A\u54EA\u5929\uFF0C\u5168\u4E16\u754C\u7684\u4EBA\u90FD\u4F1A\u6765\u8FD9\u91CC\u5462\uFF1F\u201D "
    japanese: 
  - stringId: string_meow_6004
    korean: " \u201C\uC88B\uC544! \uC774 \uAC00\uAC8C\uB97C \uC2DC\uC791\uC73C\uB85C,
      \uAC00\uC7A5 \uB530\uB73B\uD558\uACE0 \uC990\uAC70\uC6B4 \uC7A5\uC18C\uB97C
      \uB9CC\uB4E4\uC5B4\uBCF4\uC790!\u201D "
    english: " \u201CAlright! Starting with this shop, let's create the warmest and
      most joyful place!\u201D "
    chinese: " \u201C\u597D\uFF01\u5C31\u4ECE\u8FD9\u5BB6\u5E97\u5F00\u59CB\uFF0C\u6253\u9020\u6700\u6E29\u6696\u5FEB\u4E50\u7684\u5730\u65B9\u5427\uFF01\u201D "
    japanese: 
  - stringId: string_Fifi_6004
    korean: "\u201C\uADF8\uB7FC \uC2DC\uC791\uD574\uBCFC\uAE4C? \uBA3C\uC800 \uB3C4\uB11B\uBD80\uD130
      \uB9CC\uB4E4\uC5B4\uBCF4\uC790. \uC138 \uAC1C \uC774\uC0C1 \uAC19\uC740 \uBE14\uB85D\uC744
      \uB9DE\uCD94\uBA74 \uB3C4\uB11B\uC774 \uC644\uC131\uB3FC. \uC790, \uC900\uBE44\uB410\uC9C0?\u201D"
    english: "\u201CShall we get started? First, let's make a donut. Match three
      or more of the same blocks to complete it. Ready?\u201D"
    chinese: "\u201C\u90A3\u6211\u4EEC\u5F00\u59CB\u5427\uFF1F\u5148\u6765\u505A\u751C\u751C\u5708\u3002\u4E09\u4E2A\u6216\u4E09\u4E2A\u4EE5\u4E0A\u76F8\u540C\u7684\u65B9\u5757\u8FDE\u5728\u4E00\u8D77\u5C31\u80FD\u5B8C\u6210\u751C\u751C\u5708\u3002\u597D\u4E86\uFF0C\u51C6\u5907\u597D\u4E86\u5417\uFF1F\u201D"
    japanese: 
  - stringId: "(\uCC55\uD130 1 : \uAC00\uAD6C \uC644\uC131\uB3C4 0%)"
    korean: 
    english: 
    chinese: 
    japanese: 
  - stringId: string_Fifi_6005
    korean: "\u201C\uC88B\uC544, \uC774\uC81C \uC9C4\uC9DC \uC2DC\uC791\uC774\uC57C.
      \uCCAB \uC190\uB2D8\uC744 \uB9DE\uC774\uD560 \uC900\uBE44\uB97C \uD574\uBCF4\uC790.\u201D"
    english: Alright, now it's really starting. Let's get ready to welcome our first
      customer.
    chinese: "\u201C\u597D\uFF0C\u73B0\u5728\u624D\u771F\u6B63\u5F00\u59CB\u3002\u51C6\u5907\u8FCE\u63A5\u7B2C\u4E00\u4F4D\u5BA2\u4EBA\u5427\u3002\u201D"
    japanese: 
  - stringId: string_meow_6005
    korean: "\u201C\uC751, \uBA3C\uC800 \uB3C4\uB11B\uBD80\uD130 \uB9CC\uB4E4\uC5B4\uC57C\uACA0\uC9C0.\u201D"
    english: "\u201CYeah, I guess I should make the doughnuts first.\u201D"
    chinese: "\u201C\u55EF\uFF0C\u5F97\u5148\u505A\u751C\u751C\u5708\u624D\u884C\u3002\u201D"
    japanese: 
  - stringId: string_Lulu_6001
    korean: "\u201C\uC5EC\uAE30\u2026 \uC815\uB9D0 \uB2E4\uC2DC \uBB38 \uC5F0 \uAC74\uAC00\uC694?
      \uC5B4\uB9B4 \uB54C \uBA39\uB358 \uADF8 \uB3C4\uB11B\uC774 \uADF8\uB9AC\uC6E0\uC5B4\uC694.\u201D"
    english: "\u201CIs this place... really open again? I missed those donuts I used
      to eat as a kid.\u201D"
    chinese: "\u201C\u8FD9\u91CC\u2026\u2026\u771F\u7684\u91CD\u65B0\u5F00\u5F20\u4E86\u5417\uFF1F\u6211\u4E00\u76F4\u6000\u5FF5\u5C0F\u65F6\u5019\u5403\u8FC7\u7684\u90A3\u4E2A\u751C\u751C\u5708\u3002\u201D"
    japanese: 
  - stringId: string_Toto_6001
    korean: "\u201C\uC800\uB3C4 \uC18C\uBB38 \uB4E3\uACE0 \uC654\uC5B4\uC694\u2026
      \uCC9C\uCC9C\uD788 \uB9DB\uBCFC \uC218 \uC788\uC744\uAE4C\uC694?\u201D"
    english: I heard about it too and came over... Can I take my time tasting it?
    chinese: "\u201C\u6211\u4E5F\u542C\u8BF4\u4E86\u98CE\u58F0\u624D\u6765\u7684\u2026\u2026\u80FD\u6162\u6162\u54C1\u5C1D\u5417\uFF1F\u201D"
    japanese: 
  - stringId: string_Bambi_6001
    korean: "\u201C\uC6B0\uC640\u2026 \uC5EC\uAE30\uAC00 \uBC14\uB85C \uADF8 \uB3C4\uB11B
      \uAC00\uAC8C\uAD70\uC694! \uC624\uB298\uC740 \uAF2D \uB9DB\uBCF4\uACE0 \uC2F6\uC5C8\uC5B4\uC694.\u201D"
    english: Wow... This is that famous donut shop! I really wanted to try them today.
    chinese: "\u54C7\u2026\u8FD9\u91CC\u5C31\u662F\u90A3\u5BB6\u751C\u751C\u5708\u5E97\u554A\uFF01\u4ECA\u5929\u6211\u7279\u522B\u60F3\u5C1D\u5C1D\u770B\u3002"
    japanese: 
  - stringId: string_Leo_6001
    korean: "\u201C\uD558\uD558! \uB09C \uADF8\uB0E5 \uB3C4\uB11B \uD558\uB098\uB85C\uB294
      \uBD80\uC871\uD574. \uCD08\uCF54 \uB3C4\uB11B \uBC15\uC2A4\uB294 \uAF2D \uCC59\uACA8\uC8FC\uB77C\uACE0!\u201D"
    english: "\u201CHa ha! One donut just isn't enough for me. Make sure to pack
      a box of chocolate donuts!\u201D"
    chinese: "\u201C\u54C8\u54C8\uFF01\u6211\u53EF\u4E0D\u80FD\u53EA\u5403\u4E00\u4E2A\u751C\u751C\u5708\u3002\u4E00\u5B9A\u8981\u7ED9\u6211\u51C6\u5907\u5DE7\u514B\u529B\u751C\u751C\u5708\u793C\u76D2\uFF01\u201D"
    japanese: 
  - stringId: string_Lulu_6002
    korean: " \u201C\uC6B0\uC640\u2026 \uC774 \uB9DB\uC774\uC5D0\uC694! \uB2E4\uC2DC
      \uCC3E\uC544\uC640\uC11C \uC815\uB9D0 \uB2E4\uD589\uC774\uC5D0\uC694.\u201D"
    english: ' Wow... This is the taste! I''m so glad I came back.'
    chinese: " \u54C7\u2026\u5C31\u662F\u8FD9\u4E2A\u5473\u9053\uFF01\u80FD\u518D\u6B21\u627E\u5230\u5B83\u771F\u662F\u592A\u597D\u4E86\u3002"
    japanese: 
  - stringId: string_Toto_6002
    korean: "\u201C\uD760\u2026 \uC815\uB9D0 \uB2F4\uBC31\uD558\uACE0 \uB9DB\uC788\uB124\uC694.
      \uC624\uB79C\uB9CC\uC5D0 \uC774\uB7F0 \uAE30\uBD84\uC774\uC5D0\uC694.\u201D"
    english: Hmm... It's really light and delicious. It's been a while since I've
      felt this way.
    chinese: "\u201C\u55EF\u2026\u771F\u662F\u6E05\u6DE1\u53C8\u7F8E\u5473\u554A\u3002\u597D\u4E45\u6CA1\u5C1D\u5230\u8FD9\u79CD\u6ECB\u5473\u4E86\u3002\u201D"
    japanese: 
  - stringId: string_Bambi_6002
    korean: "\u201C\uB2EC\uCF64\uD558\uBA74\uC11C\uB3C4 \uD5A5\uAE0B\uD574\uC694\u2026
      \uC55E\uC73C\uB85C \uC790\uC8FC \uC640\uC57C\uACA0\uB294\uAC78\uC694!\u201D"
    english: "\u201CSweet and fragrant... I'll have to come here more often!\u201D"
    chinese: "\u201C\u53C8\u751C\u53C8\u9999\u2026\u2026\u4EE5\u540E\u5F97\u5E38\u6765\u624D\u884C\u554A\uFF01\u201D"
    japanese: 
  - stringId: string_Leo_6002
    korean: "\u201C\uC88B\uC544! \uCD08\uCF54 \uB3C4\uB11B \uBC15\uC2A4\uAC00 \uAC00\uB4DD\uD558\uB2C8
      \uB9C8\uC74C\uC774 \uB4E0\uB4E0\uD574! \uC624\uB298 \uC81C\uB300\uB85C \uB9CC\uC871\uD588\uC5B4.\u201D"
    english: "\u201CAlright! My heart feels full with this box of chocolate donuts!
      I'm totally satisfied today.\u201D"
    chinese: "\u201C\u592A\u68D2\u4E86\uFF01\u5DE7\u514B\u529B\u751C\u751C\u5708\u76D2\u5B50\u88C5\u5F97\u6EE1\u6EE1\u5F53\u5F53\uFF0C\u5FC3\u91CC\u7279\u522B\u8E0F\u5B9E\uFF01\u4ECA\u5929\u771F\u662F\u5403\u5F97\u5FC3\u6EE1\u610F\u8DB3\u554A\u3002\u201D"
    japanese: 
  - stringId: string_Fifi_6006
    korean: "\u201C\uCCAB \uC190\uB2D8\uB4E4\uC744 \uC774\uB807\uAC8C \uB9CC\uC871\uC2DC\uD0A4\uB2E4\uB2C8,
      \uC815\uB9D0 \uC798\uD588\uC5B4!\u201D"
    english: "\u201CYou did a great job satisfying our first customers like this!\u201D"
    chinese: "\u201C\u80FD\u8BA9\u7B2C\u4E00\u6279\u5BA2\u4EBA\u8FD9\u4E48\u6EE1\u610F\uFF0C\u4F60\u771F\u662F\u505A\u5F97\u592A\u597D\u4E86\uFF01\u201D"
    japanese: 
  - stringId: string_meow_6006
    korean: "\u201C\uC751, \uC774 \uB290\uB08C\u2026 \uC624\uB798\uAC04\uB9CC\uC774\uB2E4.
      \uC774\uC81C \uC9C4\uC9DC\uB85C \uB2E4\uC2DC \uC2DC\uC791\uD560 \uC218 \uC788\uACA0\uC5B4.\u201D"
    english: Yeah, this feeling... it's been a while. Now I can really start over.
    chinese: "\u201C\u55EF\uFF0C\u8FD9\u79CD\u611F\u89C9\u2026\u2026\u771F\u662F\u4E45\u8FDD\u4E86\u3002\u73B0\u5728\u7EC8\u4E8E\u53EF\u4EE5\u771F\u6B63\u91CD\u65B0\u5F00\u59CB\u4E86\u3002\u201D"
    japanese: 
  - stringId: "(\uCC55\uD130 1 : \uAC00\uAD6C \uC644\uC131\uB3C4 50%)"
    korean: 
    english: 
    chinese: 
    japanese: 
  - stringId: string_Fifi_6007
    korean: "\u201C\uC624, \uC774\uC81C \uC9C4\uC9DC \uAC00\uAC8C \uAC19\uC544 \uBCF4\uC774\uB294\uAC78?\u201D"
    english: Oh, now it really looks like a store, doesn't it?
    chinese: "\u201C\u54E6\uFF0C\u73B0\u5728\u770B\u8D77\u6765\u771F\u50CF\u4E2A\u5E97\u4E86\uFF1F\u201D"
    japanese: 
  - stringId: string_meow_6007
    korean: "\u201C\uC751, \uC774\uB807\uAC8C \uBCC0\uD558\uB294 \uAC78 \uBCF4\uB2C8\uAE4C
      \uAD1C\uD788 \uBFCC\uB4EF\uD55C\uB370?\u201D"
    english: Yeah, seeing it change like this makes me feel kinda proud, doesn't
      it?
    chinese: "\u201C\u55EF\uFF0C\u770B\u7740\u5B83\u8FD9\u6837\u53D8\u5316\uFF0C\u83AB\u540D\u6709\u79CD\u81EA\u8C6A\u611F\u5462\uFF1F\u201D"
    japanese: 
  - stringId: string_Fifi_6008
    korean: "\uC88B\uC544! \uC774 \uAE30\uC138\uB85C \uB354 \uC5F4\uC2EC\uD788 \uD574\uBCF4\uC790\uACE0!"
    english: Alright! Let's keep up this momentum and work even harder!
    chinese: "\u597D\uFF01\u8D81\u7740\u8FD9\u80A1\u52B2\u513F\u518D\u52A0\u628A\u52B2\u513F\u5427\uFF01"
    japanese: 
  - stringId: string_meow_6008
    korean: "\uC751! \uD30C\uC774\uD305\uD558\uC790!"
    english: Yeah! Let's do this!
    chinese: "\u55EF\uFF01\u52A0\u6CB9\u5427\uFF01"
    japanese: 
  - stringId: "(\uCC55\uD130 1 : \uAC00\uAD6C \uC644\uC131\uB3C4 100%)"
    korean: 
    english: 
    chinese: 
    japanese: 
  - stringId: string_Fifi_6008
    korean: "\u201C\uC774\uC81C\uC57C \uAC00\uAC8C\uAC00 \uC81C \uBAA8\uC2B5\uC744
      \uCC3E\uC558\uB124. \uC815\uB9D0 \uC218\uACE0 \uB9CE\uC558\uC5B4!\u201D"
    english: "\u201CThe shop has finally regained its original look. You've really
      worked hard!\u201D"
    chinese: "\u201C\u5E97\u94FA\u7EC8\u4E8E\u6062\u590D\u539F\u8C8C\u4E86\u3002\u771F\u662F\u8F9B\u82E6\u5566\uFF01\u201D"
    japanese: 
  - stringId: string_meow_6008
    korean: "\u201C\uC751, \uC774\uC81C \uC190\uB2D8\uB4E4\uC744 \uC790\uC2E0 \uC788\uAC8C
      \uB9DE\uC774\uD560 \uC218 \uC788\uACA0\uC5B4.\u201D"
    english: "\u201CYeah, now I can confidently welcome guests.\u201D"
    chinese: "\u201C\u55EF\uFF0C\u73B0\u5728\u53EF\u4EE5\u81EA\u4FE1\u5730\u8FCE\u63A5\u5BA2\u4EBA\u4E86\u3002\u201D"
    japanese: 
  - stringId: string_Fifi_6009
    korean: "\u201C\uAC00\uAC8C\uAC00 \uC548\uC815\uB418\uBA74\u2026 \uC606\uC5D0
      \uC791\uC740 \uCE74\uD398 \uACF5\uAC04\uB3C4 \uB9CC\uB4E4 \uC218 \uC788\uC9C0
      \uC54A\uC744\uAE4C? \uC190\uB2D8\uB4E4\uC774 \uB3C4\uB11B\uACFC \uD568\uAED8
      \uC74C\uB8CC\uB97C \uC990\uAE38 \uC218 \uC788\uB3C4\uB85D \uB9D0\uC774\uC57C.\u201D"
    english: Once the shop stabilizes... maybe we could add a small cafe space next
      door? So customers can enjoy drinks with their donuts.
    chinese: "\u201C\u7B49\u5E97\u94FA\u7A33\u5B9A\u4E0B\u6765\u2026\u2026\u6216\u8BB8\u53EF\u4EE5\u5728\u65C1\u8FB9\u5F00\u4E2A\u5C0F\u5496\u5561\u9986\uFF1F\u8BA9\u5BA2\u4EBA\u80FD\u4E00\u8FB9\u5403\u751C\u751C\u5708\u4E00\u8FB9\u559D\u996E\u6599\u3002\u201D"
    japanese: 
  - stringId: string_meow_6009
    korean: "\u201C\uC88B\uC544, \uADF8\uB7FC \uB2E4\uC74C \uBAA9\uD45C\uB294 \uBBF8\uB2C8
      \uCE74\uD398 \uD655\uC7A5\uC774\uB2E4!\u201D"
    english: "\u201CAlright, then our next goal is to expand the mini cafe!\u201D"
    chinese: "\u201C\u597D\uFF0C\u90A3\u4E48\u4E0B\u4E00\u4E2A\u76EE\u6807\u5C31\u662F\u8FF7\u4F60\u5496\u5561\u9986\u7684\u6269\u5F20\u4E86\uFF01\u201D"
    japanese: 
