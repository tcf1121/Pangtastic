  strings:
  - stringId: string_coco
    korean: "\uCF54\uCF54"
    english: Coco
    chinese: "\u53EF\u53EF"
  - stringId: string_kuku
    korean: "\uCFE0\uCFE0"
    english: Kuku
    chinese: "\u5495\u5495"
  - stringId: string_dialog_6001
    korean: "\uB4DC\uB514\uC5B4\u2026 \uB0B4 \uB3C4\uB11B \uAC00\uAC8C\uAC00 \uC5F4\uB838\uC5B4.
      \uD558\uC9C0\uB9CC \uD63C\uC790\uC11C \uC798 \uD574\uB0BC \uC218 \uC788\uC744\uAE4C\u2026?"
    english: "Finally\u2026 my donut shop is open. But can I really handle it all
      by myself\u2026?"
    chinese: "\u7EC8\u4E8E\u2026\u2026\u6211\u7684\u751C\u751C\u5708\u5E97\u5F00\u5F20\u4E86\u3002\u53EF\u662F\uFF0C\u6211\u771F\u7684\u80FD\u4E00\u4E2A\u4EBA\u505A\u597D\u5417\u2026\u2026\uFF1F"
  - stringId: string_dialog_6002
    korean: "\uAC71\uC815 \uB9C8! \uB0B4\uAC00 \uC788\uC796\uC544 \uCF54\uCF54."
    english: "Don\u2019t worry! You\u2019ve got me, Coco."
    chinese: "\u522B\u62C5\u5FC3\uFF01\u6709\u6211\u5728\u5462\uFF0C\u79D1\u79D1\u3002"
  - stringId: string_dialog_6003
    korean: "\uACE0\uB9C8\uC6CC, \uCFE0\uCFE0..."
    english: Thanks, Kuku...
    chinese: "\u8C22\u8C22\u4F60\uFF0C\u5E93\u5E93\u2026\u2026"
  - stringId: string_dialog_6004
    korean: "\uB0B4\uAC00 \uC606\uC5D0\uC11C \uB3C4\uC640\uC904 \uD14C\uB2C8\uAE4C.
      \uAC19\uC774 \uBC18\uC8FD\uBD80\uD130 \uC2DC\uC791\uD558\uC790\uAD6C!"
    english: "I\u2019ll be right by your side. Let\u2019s start with the dough together!"
    chinese: "\u6211\u4F1A\u5728\u4F60\u8EAB\u8FB9\u5E2E\u5FD9\u7684\u3002\u6211\u4EEC\u5148\u4ECE\u548C\u9762\u5F00\u59CB\u5427\uFF01"
  - stringId: string_dialog_6005
    korean: "\uD14C\uC2A4\uD2B8\uC6A9 \uB098\uB808\uC774\uC158 \uC785\uB2C8\uB2E4."
    english: This is a test narration.
    chinese: "\u8FD9\u662F\u6D4B\u8BD5\u7528\u7684\u65C1\u767D\u3002"
